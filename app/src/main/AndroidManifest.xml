<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- To reach a Nextcloud, when the notes are kept on one. Kept in a folder, nothing
         leaves the phone. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Voice notes. Asked for the first time the microphone is pressed, never before. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- So a recording carries on with the screen off; Android requires a notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Keeps the processor, not the screen, awake while recording and while hearing. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Lets the text-selection menu see other apps' text actions, such as Define from the
         Dictionary, beside Copy. Without it Android 11+ hides them from this app. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- The camera apps that take a photo when asked. Android 11 sends an unaddressed
             request only to the camera the phone came with, and the Kompakt's takes none,
             so scanning has to find the others and ask one by name. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.App">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Text shared from any app becomes a new note. -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Text selected in any app, from the menu that offers Copy. -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- A second home-screen entry that opens straight into a blank note. The activity
             tells it apart by the name it was started under. -->
        <activity-alias
            android:name=".NewNote"
            android:exported="true"
            android:label="@string/new_note_label"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- A third home-screen entry, straight into a recording. -->
        <activity-alias
            android:name=".Record"
            android:exported="true"
            android:label="@string/record_label"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Addresses other apps can open: a scan opened in a PDF reader, and the file the
             camera app writes its photograph into. Only the notes and that one scratch
             folder, and only for as long as a grant lasts. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/files" />
        </provider>

        <service
            android:name=".hearing.RecordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>

</manifest>
