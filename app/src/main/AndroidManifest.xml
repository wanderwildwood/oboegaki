<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- To reach a Nextcloud, when the notes are kept on one. Kept in a folder, nothing
         leaves the phone. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Voice notes. Asked for the first time the microphone is pressed, never before. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- So a recording carries on with the screen off; Android requires a notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Keeps the processor, not the screen, awake while recording and while hearing. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Lets the text-selection menu see other apps' text actions, such as Define from the
         Dictionary, beside Copy. Without it Android 11+ hides them from this app. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- The camera apps that take a photo when asked. Android 11 sends an unaddressed
             request only to the camera the phone came with, and the Kompakt's takes none,
             so scanning has to find the others and ask one by name. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- Remind me: a calendar app that makes a new event from a title and a description. -->
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <!-- The apps allowed to write notes in through the capture provider, whose signing
             certificates it checks. -->
        <package android:name="com.wanderwildwood.yumecho" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.App">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- New note and Record, offered on a long press of the icon by launchers that
                 show shortcuts, rather than as entries of their own in the drawer: he wants
                 the one app there. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!-- Text shared from any app becomes a new note. -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Pictures shared from the gallery, the camera or Files: a note that shows them,
                 or a scan. -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- A Markdown or text file opened from another app, Files most of all. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Text selected in any app, from the menu that offers Copy. -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>



        <!-- Addresses other apps can open: a scan opened in a PDF reader, and the file the
             camera app writes its photograph into. Only the notes and that one scratch
             folder, and only for as long as a grant lasts. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/files" />
        </provider>

        <!-- The pinned notes for Glance's lock-screen panel; it answers Glance alone. -->
        <provider
            android:name=".glance.PinnedOnLockScreen"
            android:authorities="com.wanderwildwood.oboegaki.glance"
            android:exported="true" />

        <!-- Notes written in by this shop's other apps, Dream Log first. Exported with no
             permission because it checks each caller's package and signing certificate itself;
             see capture/CaptureProvider.kt and "For other apps" in the README. -->
        <provider
            android:name=".capture.CaptureProvider"
            android:authorities="com.wanderwildwood.oboegaki.capture"
            android:exported="true" />

        <service
            android:name=".hearing.RecordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>

</manifest>
